# ==========================================================================
# THE WORLD CARS - Environment Variables Configuration
# Rename to .env.local for local development and set in Vercel Project Settings
# ==========================================================================

# Supabase Cloud Database Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Telegram Bot API Credentials (Server-side Secret)
TELEGRAM_BOT_TOKEN=123456789:YOUR_SECRET_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_OR_CHANNEL_ID

# Admin Master Password SHA-256 Hash
# Default hash below is for 'admin123'
ADMIN_HASH=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
